<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HopFence.Reporting</PackageId>
    <Version>1.0.0</Version>
    <Authors>NulleN - Kadircan Üredi</Authors>
    <Company>kadircanuredi.com.tr</Company>
    <Description>Multi-format reporting engine for HopFence (Terminal, JSON, HTML, JUnit XML).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hellonullen/hopfence</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hellonullen/hopfence.git</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HopFence.Core\HopFence.Core.csproj" />
  </ItemGroup>

</Project>
